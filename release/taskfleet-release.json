{
  "schema_version": 1,
  "activation": "ready",
  "repository": "jarimustonen/taskfleet",
  "owners": ["jarimustonen"],
  "crates_io": {
    "workflow": "publish-crates.yml",
    "legs": [
      {
        "package": "taskfleet-core",
        "manifest": "crates/taskfleet-core/Cargo.toml",
        "depends_on": null
      },
      {
        "package": "taskfleet",
        "manifest": "crates/taskfleet/Cargo.toml",
        "depends_on": "taskfleet-core"
      }
    ]
  },
  "distribution": [
    {
      "package": "taskfleet",
      "registry": "gh-releases",
      "workflow": "release.yml"
    },
    {
      "package": "taskfleet",
      "registry": "homebrew",
      "workflow": "release.yml"
    }
  ]
}
