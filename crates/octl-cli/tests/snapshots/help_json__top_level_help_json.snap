          {
            "command": "orchestratectl event tail",
            "about": "Stream events from a run's `events.jsonl`. Tails to EOF and exits (or follows the file with `--follow`, polling every 500ms)",
            "long_about": "Stream events from a run's `events.jsonl`. Tails to EOF and exits (or follows the file with `--follow`, polling every 500ms).\n\nJSONL mode emits one object per line and terminates with exactly one `{\"event\":\"result\"|\"cancelled\",\"schema_version\":1, ...}` envelope. With `--follow`, SIGINT exits 130. SIGTERM also exits 130 (known divergence from AGENTS-AI-FIRST-CLI §12's 143 — `ctrlc` does not surface the signal value; see comment in `tail.rs`).",
            "aliases": [],
            "hidden": false,
            "deprecated": false,
            "flags": [
              {
                "name": "follow",
                "long": "follow",
                "long_aliases": [],
                "short_aliases": [],
